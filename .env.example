# Local settings for Virtual Cut's scripts (tests, studies, delivery). Copy this file to .env at
# the repository root and fill in what you use. .env is never committed. A value set for one
# run (for example `$env:VIRTUAL_CUT_SUITE_OUTPUT = '...'`) wins over the file. The app itself
# never reads .env, so builds behave the same on any PC. Write paths without quotes.

# Scratch folder for check and study output. Empty: the OS temp folder (%TEMP%\virtual-cut).
VIRTUAL_CUT_SCRATCH=

# Where each suite run gets its run-* folder. The suite keeps the five newest. Empty: scratch\test-runs.
VIRTUAL_CUT_SUITE_OUTPUT=

# Where `npm run deliver` keeps test-runs, builds, evidence and temp. Empty: the scratch folder.
VIRTUAL_CUT_DELIVERY_ROOT=

# Where `npm run package:win` writes builds. Empty: release\ in the repository.
VIRTUAL_CUT_PACKAGE_DIR=

# FFmpeg and FFprobe executables. Empty: ffmpeg and ffprobe on PATH.
VIRTUAL_CUT_FFMPEG=
VIRTUAL_CUT_FFPROBE=

# Python 3 for the Resolve helper tests. Empty: python on PATH.
VIRTUAL_CUT_PYTHON=

# Local speech engine for the real-recognition studies. Leave empty unless you run them: the app
# started by desktop checks inherits these too.
VIRTUAL_CUT_ASR_PYTHON=
VIRTUAL_CUT_ASR_LIBRARIES=
VIRTUAL_CUT_ASR_MODEL=

# Screen text engine install folder (python\python.exe and libraries\) for development and checks.
# Empty: the folder chosen in the app's setup, else the bundled one. Desktop checks inherit it.
VIRTUAL_CUT_OCR_RUNTIME=

# Folder of labelled cue recordings (each .mp4 with a .txt) for cue-accuracy-study.mjs.
VIRTUAL_CUT_CUE_SAMPLES=

# Folder holding the 4K transport fixture (latest-fixture.json) for the transport check and
# studies. Build it with: node scripts/transport-fixture.mjs <disposable copy of a 4K recording>
VIRTUAL_CUT_TRANSPORT_FIXTURE=

# Folder for the disposable media resolve-live-fixture.mjs makes. Empty: scratch\resolve-validation.
VIRTUAL_CUT_RESOLVE_FIXTURE=
