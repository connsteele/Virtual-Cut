{
  "name": "virtual-cut",
  "productName": "Virtual Cut",
  "version": "0.4.28",
  "private": true,
  "description": "The Virtual Cut footage workspace.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:workflow": "node scripts/workflow-smoke.mjs",
    "test:media": "node --test scripts/media.test.mjs",
    "test:project": "node scripts/project-checks.mjs",
    "test:long": "node scripts/project-long-checks.mjs",
    "package:win": "node scripts/package-windows.mjs",
    "lint": "oxlint --type-aware",
    "format": "prettier --write --cache src electron scripts *.json *.ts *.html *.md docs/foundation.md docs/layout-concepts.md",
    "format:check": "prettier --check --cache src electron scripts *.json *.ts *.html *.md docs/foundation.md docs/layout-concepts.md",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "test:feedback": "node scripts/feedback-checks.mjs",
    "test:playback": "node scripts/build.mjs && node scripts/playback-ui-checks.mjs",
    "test:export": "node scripts/export-checks.mjs",
    "test:folders": "node --experimental-strip-types --test scripts/source-folders.test.mjs",
    "test:tools": "node scripts/intake-zoom-checks.mjs",
    "test:review-fixes": "node scripts/build.mjs && node scripts/review-fixes-checks.mjs",
    "test:review-planning": "node scripts/review-planning-checks.mjs",
    "test": "node scripts/test-suite.mjs fast",
    "test:suite": "node scripts/test-suite.mjs",
    "test:native": "node scripts/test-suite.mjs native",
    "test:desktop": "node scripts/test-suite.mjs desktop",
    "test:packaged": "node scripts/test-suite.mjs packaged",
    "test:coverage": "node scripts/test-suite.mjs desktop --coverage",
    "deliver": "node scripts/deliver.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "resedit": "3.1.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
