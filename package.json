{
  "name": "virtual-cut",
  "productName": "Virtual Cut",
  "version": "0.3.9",
  "private": true,
  "description": "The Virtual Cut footage workspace.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:workflow": "node scripts/workflow-smoke.mjs",
    "test:media": "node --test scripts/media.test.mjs",
    "test:project": "node scripts/project-checks.mjs",
    "test:long": "node scripts/project-long-checks.mjs",
    "package:win": "node scripts/package-windows.mjs",
    "lint": "eslint .",
    "format": "prettier --write src electron scripts *.json *.ts *.mjs *.html *.md docs/foundation.md docs/layout-concepts.md",
    "format:check": "prettier --check src electron scripts *.json *.ts *.mjs *.html *.md docs/foundation.md docs/layout-concepts.md",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "test:feedback": "node scripts/feedback-checks.mjs",
    "test:playback": "node scripts/build.mjs && node scripts/playback-ui-checks.mjs",
    "test:export": "node scripts/export-checks.mjs",
    "test:folders": "node --experimental-strip-types --test scripts/source-folders.test.mjs",
    "test:tools": "node scripts/intake-zoom-checks.mjs",
    "test:review-fixes": "node scripts/build.mjs && node scripts/review-fixes-checks.mjs",
    "test:review-planning": "node scripts/review-planning-checks.mjs"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "resedit": "3.1.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1"
  }
}
